{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#e4639d8a260648df0120b3d1d6b6294b0d0e6b2f", // main
    "github>tbhb-dev/renovate-config//bazel.json5#e4639d8a260648df0120b3d1d6b6294b0d0e6b2f", // main
    "github>tbhb-dev/renovate-config//go.json5#e4639d8a260648df0120b3d1d6b6294b0d0e6b2f", // main
  ],

  // avirt needs nothing beyond the presets: its Go module and Bazel pins are
  // both covered there.
}
