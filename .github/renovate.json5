{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#653205d61dc0646bb96ae5731b93410667fbb37e", // main
    "github>tbhb-dev/renovate-config//bazel.json5#653205d61dc0646bb96ae5731b93410667fbb37e", // main
    "github>tbhb-dev/renovate-config//go.json5#653205d61dc0646bb96ae5731b93410667fbb37e", // main
    "github>tbhb-dev/renovate-config//python.json5#653205d61dc0646bb96ae5731b93410667fbb37e", // main
  ],

  // avirt needs nothing beyond the presets: its Go module, Bazel pins and uv
  // lock are all covered there.
}
