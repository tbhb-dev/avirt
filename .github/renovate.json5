{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#1c38f097a901ed35237b24fad045ae8b30e744ec", // main
    "github>tbhb-dev/renovate-config//bazel.json5#1c38f097a901ed35237b24fad045ae8b30e744ec", // main
    "github>tbhb-dev/renovate-config//go.json5#1c38f097a901ed35237b24fad045ae8b30e744ec", // main
  ],

  // avirt needs nothing beyond the presets: its Go module and Bazel pins are
  // both covered there.
}
