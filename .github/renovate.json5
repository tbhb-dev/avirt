{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#93c35d1818ac96d9434051b00d5d23c7651cdfe9", // main
    "github>tbhb-dev/renovate-config//bazel.json5#93c35d1818ac96d9434051b00d5d23c7651cdfe9", // main
    "github>tbhb-dev/renovate-config//go.json5#93c35d1818ac96d9434051b00d5d23c7651cdfe9", // main
  ],

  // avirt needs nothing beyond the presets: its Go module and Bazel pins are
  // both covered there.
}
