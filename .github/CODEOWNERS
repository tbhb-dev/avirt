# Review routing for avirt. GitHub applies the last matching rule, so the
# supply-chain rules below override the default for the paths they name.

# Default owner for everything.
*           @tbhb

# Supply-chain and CI surface. The /.github/ rule already covers
# renovate.json5 and every workflow, so neither needs its own line.
/.github/       @tbhb
/Cargo.toml     @tbhb
/Cargo.lock     @tbhb
/deny.toml      @tbhb
/mise.toml      @tbhb
/mise.lock      @tbhb
