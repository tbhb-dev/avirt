{
  "language": "en",
  "ignorePaths": [
    ".mise/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    ".venv/**/*",
    ".bazel-*/**/*",
    "bazel-*/**/*",
    "coverage.xml",
    "go.sum",
    "LICENSE",
    "MODULE.bazel.lock",
    "mise.lock",
    "tmp/**/*",
    "tools/testdata/**/*"
  ],
  "dictionaryDefinitions": [
    {
      "name": "avirt",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["avirt", "golang", "python"]
}
