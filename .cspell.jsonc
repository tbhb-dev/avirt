{
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    "**/*.log",
    "apm_modules/**/*",
    // Agent primitives deployed from tbhb-dev/devtools and pinned by
    // content hash in apm.lock.yaml. Their vocabulary is upstream's.
    ".agents/skills/**/*",
    ".agents/rules/**/*",
    ".claude/rules/**/*",
    ".claude/skills/**/*",
    ".claude/worktrees/**/*",
    ".codex/worktrees/**/*",
    ".worktrees/**/*",
    // The vendored devtools payload answers to the publisher's dictionary.
    ".config/mise/**/*",
    ".devtools/**/*",
    ".rumdl_cache/**/*",
    ".vale/**/*",
    "apm.lock.yaml",
    // Dependency lockfiles contain generated names and checksums.
    "Cargo.lock",
    "**/Cargo.lock",
    "target/**/*",
    "logs/**/*",
    "spikes/**/*",
    "vendor/**/*",
    "mise.lock",
    "dist/**/*",
    "coverage.xml",
    // Private values, gitignored; nothing in it belongs in a dictionary.
    "mise.local.toml",
    "tmp/**/*",
    "vendir.lock.yml",
    "LICENSE"
  ],
  // Address literals and the malformed host are parser rejection fixtures.
  "overrides": [
    {
      "filename": [
        "experiments/poc/crates/avirt-connect/src/lib.rs",
        "experiments/poc/crates/avirt-connect/src/tests.rs"
      ],
      "ignoreRegExpList": [
        "/the_hosts_own_addresses_are_recognised/g",
        "/\"[0-9a-f]*:[0-9a-f:]+\"/gi",
        "/exa\\/mple\\.com/g"
      ]
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "avirt",
      "path": "./.cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["avirt", "rust"]
}
